{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "ivory", "name": "Ivory", "color": "#f4f0e7" },
        { "slug": "paper", "name": "Paper", "color": "#fffdf8" },
        { "slug": "ink", "name": "Ink", "color": "#171916" },
        { "slug": "charcoal", "name": "Charcoal", "color": "#30332f" },
        { "slug": "sage", "name": "Sage", "color": "#7e8b76" },
        { "slug": "clay", "name": "Clay", "color": "#b55e3c" },
        { "slug": "navy", "name": "Navy", "color": "#17304e" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "vw", "%"],
      "spacingSizes": [
        { "slug": "20", "size": "0.75rem", "name": "Small" },
        { "slug": "40", "size": "1.5rem", "name": "Medium" },
        { "slug": "60", "size": "3rem", "name": "Large" },
        { "slug": "80", "size": "6rem", "name": "XL" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "sans", "name": "Studio Sans", "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" },
        { "slug": "display", "name": "Editorial Display", "fontFamily": "Iowan Old Style, Baskerville, Times New Roman, serif" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.82rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "clamp(1.25rem, 1rem + 1vw, 2rem)", "name": "Large" },
        { "slug": "x-large", "size": "clamp(2.3rem, 1.4rem + 4vw, 5.6rem)", "name": "Extra Large" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--ivory)", "text": "var(--wp--preset--color--ink)" },
    "spacing": { "blockGap": "1.5rem" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "lineHeight": "1.65" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.05" } },
      "link": { "color": { "text": "var(--wp--preset--color--ink)" }, ":hover": { "color": { "text": "var(--wp--preset--color--clay)" } } }
    }
  }
}
