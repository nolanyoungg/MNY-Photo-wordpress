{
  "name": "mnyphoto-theme",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "webpack --config build/webpack.config.js --mode development --watch",
    "build": "webpack --config build/webpack.config.js --mode production && node build/validate.js",
    "lint:php": "node build/lint-php.js",
    "package": "node build/package-theme.js --preflight && npm run build && node build/package-theme.js"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.2",
    "sass": "^1.86.0",
    "sass-loader": "^16.0.5",
    "webpack": "5.100.2",
    "webpack-cli": "^6.0.1"
  }
}
